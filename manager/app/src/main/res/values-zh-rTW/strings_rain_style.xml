<resources>
    <string name="interface_style_rain">雨境</string>
    <string name="settings_rain_style">雨勢切換</string>
    <string name="rain_style_light">小雨</string>
    <string name="rain_style_light_summary">淺灰藍薄霧、稀疏雨線與安靜水波，卡片像覆著一層輕盈雨水。</string>
    <string name="rain_style_medium">中雨</string>
    <string name="rain_style_medium_summary">雨線漸密、雲層加深，卡片水簷與凝露更加清晰。</string>
    <string name="rain_style_heavy">暴雨</string>
    <string name="rain_style_heavy_summary">更密集的雨幕、藍灰配色與明顯的落地水波，配色跟隨日夜主題。</string>
    <string name="rain_style_thunderstorm">雷陣雨</string>
    <string name="rain_style_thunderstorm_summary">密集雨幕與紫灰色調，跟隨日夜主題，不含閃光效果。</string>
    <string name="rain_style_after_rain">雨後</string>
    <string name="rain_style_after_rain_summary">雨勢逐漸減弱，雲層緩慢打開，濕潤玻璃與地面重新映出微光。</string>
    <string name="rain_motto_light">聽雨落在玻璃上</string>
    <string name="rain_motto_medium">雨聲漸密，世界漸靜</string>
    <string name="rain_motto_heavy">穿過風雨，仍然清醒</string>
    <string name="rain_motto_thunderstorm">雷光劃夜，守住內核</string>
    <string name="rain_motto_after_rain">雨過之後，水面重新有了光</string>
    <string name="theme_preset_rain">雨境</string>
    <string name="theme_preset_rain_summary">冷灰藍雨幕、濕潤卡片邊緣、水簷頂部裝飾與聯動懸浮底欄。</string>
</resources>
