# Replace comments.example.com and certificate paths before enabling this config.
server {
    listen 80;
    server_name comments.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name comments.example.com;
    ssl_certificate /etc/letsencrypt/live/comments.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/comments.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;

    location / {
        proxy_pass http://127.0.0.1:8360;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This is the only public proxy: replace, rather than trust, a client-supplied chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        add_header X-Content-Type-Options nosniff always;
    }
}
